<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cyrilsx</groupId>
        <artifactId>russian-cases-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>russian-cases-android</artifactId>
    <name>russian-cases-android</name>
    <packaging>apk</packaging>
    <description>Android app (fr/en, Kotlin sources) to learn and practise Russian grammatical cases - built as an APK with android-maven-plugin</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <android.platform>29</android.platform>
        <android.build-tools>30.0.3</android.build-tools>
        <android-maven-plugin.version>4.6.0</android-maven-plugin.version>
        <kotlin.version>1.3.72</kotlin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>android</artifactId>
            <version>4.1.1.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                                <sourceDir>${project.build.directory}/generated-sources/r</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>1.8</jvmTarget>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.simpligility.maven.plugins</groupId>
                <artifactId>android-maven-plugin</artifactId>
                <version>${android-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <sdk>
                        <platform>${android.platform}</platform>
                        <buildTools>${android.build-tools}</buildTools>
                    </sdk>
                    <dex>
                        <dexArguments>--min-sdk-version=26</dexArguments>
                    </dex>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>javax.xml.bind</groupId>
                        <artifactId>jaxb-api</artifactId>
                        <version>2.3.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.glassfish.jaxb</groupId>
                        <artifactId>jaxb-runtime</artifactId>
                        <version>2.3.1</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- single antrun plugin with two executions:
                 1) shim-legacy-source-properties (validate): legacy tools/source.properties for android-maven-plugin
                 2) zipalign-apk (package): 4-byte alignment of stored entries such as resources.arsc -
                    required on Android 11+ when targetSdk >= 30, otherwise adb install fails with
                    [-124 ... resources.arsc ... uncompressed and aligned on a 4-byte boundary] -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>shim-legacy-source-properties</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${env.ANDROID_HOME}/tools"/>
                                <echo file="${env.ANDROID_HOME}/tools/source.properties">Pkg.Revision=26.1.1</echo>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>zipalign-apk</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${env.ANDROID_HOME}/build-tools/${android.build-tools}/zipalign"
                                      failonerror="true">
                                    <arg value="-f"/>
                                    <arg value="4"/>
                                    <arg value="${project.build.directory}/${project.build.finalName}.apk"/>
                                    <arg value="${project.build.directory}/${project.build.finalName}-aligned.apk"/>
                                </exec>
                                <move file="${project.build.directory}/${project.build.finalName}-aligned.apk"
                                      tofile="${project.build.directory}/${project.build.finalName}.apk"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
